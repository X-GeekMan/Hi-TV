    <string name="guide_done">完成并进入桌面</string>
    <string name="guide_final_title">欢迎进入 Hi TV</string>
    <string name="guide_final_body">你的电视，从现在开始焕然一新。</string>
    <string name="guide_update_title">Hi TV，处处焕新。</string>
    <string name="guide_update_body">基于 Null_ 的 Halo TV 二次开发。相比原版，Hi TV 加入更多桌面样式与可调选项，让你按喜好和电视性能布置主屏幕。</string>
    <string name="guide_update_dock">Dock 新增液态玻璃底板</string>
    <string name="guide_update_focus">应用焦点新增液态玻璃滑动</string>
    <string name="guide_update_performance">流畅／均衡／效果性能模式</string>
